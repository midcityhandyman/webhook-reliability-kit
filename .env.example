# All optional. The demo and tests run offline with built in fake values.
# These are placeholders, not real secrets. Never commit a real secret.
WEBHOOK_KIT_INBOUND_SECRET=inbound-secret-not-real
WEBHOOK_KIT_OUTBOUND_SECRET=outbound-secret-not-real
# SQLite file for the sender side. Default is an in memory database.
WEBHOOK_KIT_DB=:memory:
